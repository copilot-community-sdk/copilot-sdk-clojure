{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/core.async {:mvn/version "1.8.741"}
        org.clojure/spec.alpha {:mvn/version "0.6.249"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        net.java.dev.jna/jna {:mvn/version "5.19.1"}
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:test
  {:extra-paths ["test" "script"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.2"}
                org.slf4j/slf4j-simple {:mvn/version "2.0.16"}
                codox/codox {:mvn/version "0.10.8"}
                io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  :native-darwin-arm64
  {:extra-deps {com.microsoft/copilot-sdk-runtime$darwin-arm64 {:mvn/version "2.0.3"}}}
  :native-linux-x64
  {:extra-deps {com.microsoft/copilot-sdk-runtime$linux-x64 {:mvn/version "2.0.3"}}}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.11"}}
          :ns-default build}
  :codox {:extra-paths ["script"]
          :extra-deps {codox/codox {:mvn/version "0.10.8"}}
          :exec-fn generate-docs/generate-docs
          :exec-args {:source-paths ["src"]
                      :namespaces [github.copilot-sdk github.copilot-sdk.instrument
                                   github.copilot-sdk.specs github.copilot-sdk.tool-set]
                      :output-path "doc/api"
                      :metadata {:doc/format :markdown}}}
  :fmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.0"}}
        :main-opts ["-m" "cljfmt.main"]}
  :examples {:extra-paths ["examples"]
             :extra-deps {org.slf4j/slf4j-simple {:mvn/version "2.0.16"}}}}}
