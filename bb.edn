{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}}
 :tasks
 {test {:doc "Run the hermetic test suite without requiring a native classifier."
        :task (clojure "-M:test" "-m" "cognitect.test-runner" "-e" "native")}

  test:native
  {:doc "Run real in-process acceptance tests with the indicated platform classifier."
   :task (let [[platform & more] *command-line-args*]
           (when (or (seq more) (not (#{"native-darwin-arm64" "native-linux-x64"} platform)))
             (throw (ex-info "Select native-darwin-arm64 or native-linux-x64" {})))
           (clojure (str "-M:test:" platform)
                    "-m" "cognitect.test-runner" "-i" "native"))}

  api-surface:update {:doc "Regenerate the native public API snapshot."
                      :task (clojure "-M:test" "-m" "github.copilot-sdk.native-surface-test" "--update")}

  fmt {:doc "Format all Clojure files."
       :task (clojure "-M:fmt" "fix" "src" "test" "examples")}

  fmt:check {:doc "Check formatting without modifying files."
            :task (clojure "-M:fmt" "check" "src" "test" "examples")}

  docs {:doc "Generate API documentation with codox."
        :task (clojure "-X:codox")}

  jar {:doc "Build the JAR and POM."
       :task (clojure "-T:build" "jar")}

  test:artifact {:doc "Test a clean consumer of the built JAR with its native classifier."
                 :task (apply shell "bb" "script/test_native_artifact.clj" *command-line-args*)}

  ci {:doc "Run hermetic tests, validate docs, and build the JAR. No classifier required."
      :depends [test validate-docs jar]}

  ci:full {:doc "Run all credential-free gates. Pass native-darwin-arm64 or native-linux-x64."
           :task (do (run 'test:native)
                     (shell "./run-all-examples.sh")
                     (run 'ci)
                     (run 'test:artifact))}

  install {:doc "Install the JAR locally (build via ci)."
           :task (clojure "-T:build" "install")}

  validate-docs {:doc "Validate documentation: links, code blocks, and structure."
                 :task (shell "bb" "-cp" "script" "script/validate_docs.clj")}

  schemas:fetch {:doc "Fetch Copilot CLI release JSON Schemas at the pinned version into schemas/."
                 :task (shell "bb" "script/codegen/fetch_schemas.clj")}

  codegen {:doc "Regenerate Clojure code from upstream JSON Schemas in schemas/."
           :task (shell "bb" "-cp" "script" "-m" "codegen.main")}}}
