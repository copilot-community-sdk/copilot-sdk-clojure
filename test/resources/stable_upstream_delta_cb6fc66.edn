 :workflow-exclusion
 {:classification :experimental :decision :exclude :authority :stable-only-policy
  :decision-source "AGENTS.md"
  :reason "workflow.ts marks Dynamic Workflows @experimental. Existing factory approval is not authorization for this distinct subsystem."
  :existing-factories :unchanged-supported-experimental
  :root-and-extension-export-group :workflows
  :join-change "Private JoinSessionContributionConfig makes factories/workflows mutually exclusive; JoinSessionConfig gains the workflow branch. Default permission handler, suppressResumeEvent, environment requests, and existing factory-only joins retain their behavior."
  :client-change "Internal resumeSessionForExtension normalizes legacy factory arrays or contribution objects, registers workflows, and serializes optional workflow metadata only for extension contributions."
  :session-change "readonly workflow adds run/resume/getRun/waitForRun/listRuns/getRunDetail/getRunProgress/pause/cancel. Private helpers, registerWorkflows reverse execute/abort handlers, per-execution cancellation, progress buffering, and cleanup serve only workflow execution."
  :internal-export-group :workflow-internals}

